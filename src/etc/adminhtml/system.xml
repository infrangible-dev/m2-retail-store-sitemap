<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="sitemap">
            <group id="retail_store" translate="label" type="text" sortOrder="820" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Retail Store</label>
                <field id="export" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Export</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="changeFrequency" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Frequency</label>
                    <source_model>Magento\Sitemap\Model\Config\Source\Frequency</source_model>
                    <depends>
                        <field id="export">1</field>
                    </depends>
                </field>
                <field id="priority" translate="label comment" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Priority</label>
                    <backend_model>Magento\Sitemap\Model\Config\Backend\Priority</backend_model>
                    <comment>Valid values range from 0.0 to 1.0.</comment>
                    <depends>
                        <field id="export">1</field>
                    </depends>
                </field>
            </group>
        </section>
        <section id="infrangible_sitemap">
            <group id="retail_store" translate="label" type="text" sortOrder="820" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Retail Store</label>
                <field id="export" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Export</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="changeFrequency" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Change Frequency</label>
                    <source_model>Infrangible\Sitemap\Model\Config\Source\ChangeFrequency</source_model>
                    <depends>
                        <field id="export">1</field>
                    </depends>
                </field>
                <field id="priority" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Priority</label>
                    <depends>
                        <field id="export">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
