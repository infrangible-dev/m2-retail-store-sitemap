<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <sitemap>
            <retail_store>
                <export>1</export>
                <changeFrequency>monthly</changeFrequency>
                <priority>1.0</priority>
            </retail_store>
        </sitemap>
        <infrangible_sitemap>
            <retail_store>
                <export>1</export>
                <changeFrequency>monthly</changeFrequency>
                <priority>1.0</priority>
            </retail_store>
            <source>
                <retail_store>Infrangible\RetailStoreSitemap\Model\Source</retail_store>
            </source>
        </infrangible_sitemap>
    </default>
</config>
