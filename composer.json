{
    "name": "infrangible/m2-retail-store-sitemap",
    "description": "Adds the detail pages of your retail stores to the XML sitemap, with frequency and priority settings and an option to exclude single stores.",
    "type": "magento2-module",
    "version": "1.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Sitemaps",
        "SEO",
        "Store locator",
        "store pages in the XML sitemap",
        "store locator sitemap"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-retail-store-sitemap",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~103.0.0",
        "infrangible/m2-backend-widget": "~3.7.0",
        "infrangible/m2-retail-store": "~1.5.0",
        "infrangible/m2-sitemap": "~1.0.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\RetailStoreSitemap\\": "src"
        }
    }
}
